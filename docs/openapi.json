  "components": {
    "schemas": {
      "Body_intake_intake_post": {
        "properties": {
          "ui_language": {
            "type": "string",
            "enum": [
              "en",
              "ur"
            ],
            "title": "Ui Language"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "audio": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio"
          }
        },
        "type": "object",
        "required": [
          "ui_language"
        ],
        "title": "Body_intake_intake_post"
      },
      "Body_transcribe_audio_transcribe_post": {
        "properties": {
          "audio": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio"
          },
          "target_language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "en",
                  "ur"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Language"
          }
        },
        "type": "object",
        "title": "Body_transcribe_audio_transcribe_post"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "uiLanguage": {
            "type": "string",
            "enum": [
              "en",
              "ur"
            ],
            "title": "Uilanguage"
          }
        },
        "type": "object",
        "required": [
          "question",
          "uiLanguage"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "inScope": {
            "type": "boolean",
            "title": "Inscope"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "inScope",
          "answer",
          "sources"
        ],
        "title": "ChatResponse"
      },
      "Confidence": {
        "properties": {
          "area": {
            "type": "number",
            "title": "Area"
          },
          "people": {
            "type": "number",
            "title": "People"
          },
          "urgency": {
            "type": "number",
            "title": "Urgency"
          },
          "vulnerable": {
            "type": "number",
            "title": "Vulnerable"
          },
          "supplies": {
            "type": "number",
            "title": "Supplies"
          },
          "access": {
            "type": "number",
            "title": "Access"
          }
        },
        "type": "object",
        "required": [
          "area",
          "people",
          "urgency",
          "vulnerable",
          "supplies",
          "access"
        ],
        "title": "Confidence"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorBody"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "requestId": {
            "type": "string",
            "title": "Requestid"
          }
        },
        "type": "object",
        "required": [
          "error",
          "requestId"
        ],
        "title": "ErrorEnvelope"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
