    "/chat": {
      "post": {
        "summary": "Explain live Karwan data (read-only; fixed refusal when off-topic)",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "In-scope answer, or the fixed refusal with inScope=false",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                },
                "examples": {
                  "inScope": {
                    "value": {
                      "inScope": true,
                      "answer": "Badin needed 500 units of water and received 320. Available stock was limited, so it was shared according to priority score and remaining need.",
                      "sources": [
                        {
                          "type": "allocation",
                          "id": "alc_123"
                        }
                      ]
                    }
                  },
                  "refusal": {
                    "value": {
                      "inScope": false,
                      "answer": "I can only answer questions about Karwan's requests, stock, allocations, and deliveries.",
                      "sources": []
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "VALIDATION_ERROR": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Some fields are missing or invalid. Please check your input.",
                        "retryable": false
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "AI_QUOTA_EXCEEDED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AI_QUOTA_EXCEEDED": {
                    "value": {
                      "error": {
                        "code": "AI_QUOTA_EXCEEDED",
                        "message": "The AI assistant has reached its limit for now. You can continue with the manual form.",
                        "retryable": true
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "AI_INVALID_OUTPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AI_INVALID_OUTPUT": {
                    "value": {
                      "error": {
                        "code": "AI_INVALID_OUTPUT",
                        "message": "The AI could not understand that report. Please edit it or use the manual form.",
                        "retryable": true
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "AI_UNAVAILABLE, KARWAN_API_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AI_UNAVAILABLE": {
                    "value": {
                      "error": {
                        "code": "AI_UNAVAILABLE",
                        "message": "The AI assistant is unavailable. You can continue with the manual form.",
                        "retryable": true
                      },
                      "requestId": "req_trace_123"
                    }
                  },
                  "KARWAN_API_UNAVAILABLE": {
                    "value": {
                      "error": {
                        "code": "KARWAN_API_UNAVAILABLE",
                        "message": "Karwan data is unavailable right now. Please try again shortly.",
                        "retryable": true
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "AI_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AI_TIMEOUT": {
