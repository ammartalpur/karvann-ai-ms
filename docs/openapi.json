{
  "openapi": "3.1.0",
  "info": {
    "title": "Karwan AI Service",
    "description": "Understands Karwan reports and explains Karwan data. It never saves requests, calculates scores, allocates supplies or changes stock - the Express backend does that.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/intake": {
      "post": {
        "summary": "Analyse a text or voice report (does not save anything)",
        "operationId": "intake_intake_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_intake_intake_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeResult"
                },
                "example": {
                  "area": "Dadu",
                  "people": 240,
                  "peopleIsEstimate": true,
                  "urgency": "high",
                  "vulnerable": [
                    "children",
                    "medical"
                  ],
                  "supplies": [
                    {
                      "item": "water",
                      "qty": 500
                    }
                  ],
                  "access": "hard",
                  "detectedLanguage": "ur",
                  "englishText": "About forty houses near Dadu are flooded.",
                  "confidence": {
                    "area": 0.95,
                    "people": 0.65,
                    "urgency": 0.8,
                    "vulnerable": 0.9,
                    "supplies": 0.4,
                    "access": 0.3
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "VALIDATION_ERROR": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Some fields are missing or invalid. Please check your input.",
                        "retryable": false
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "AUDIO_TOO_LARGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AUDIO_TOO_LARGE": {
                    "value": {
                      "error": {
                        "code": "AUDIO_TOO_LARGE",
                        "message": "The recording is too large. Keep it under 30 seconds or type your report.",
                        "retryable": false
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "UNSUPPORTED_AUDIO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "UNSUPPORTED_AUDIO": {
                    "value": {
                      "error": {
                        "code": "UNSUPPORTED_AUDIO",
                        "message": "That audio format is not supported. Type your report instead.",
                        "retryable": false
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "AI_QUOTA_EXCEEDED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AI_QUOTA_EXCEEDED": {
                    "value": {
                      "error": {
                        "code": "AI_QUOTA_EXCEEDED",
                        "message": "The AI assistant has reached its limit for now. You can continue with the manual form.",
                        "retryable": true
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "AI_INVALID_OUTPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AI_INVALID_OUTPUT": {
                    "value": {
                      "error": {
                        "code": "AI_INVALID_OUTPUT",
                        "message": "The AI could not understand that report. Please edit it or use the manual form.",
                        "retryable": true
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "AI_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AI_UNAVAILABLE": {
                    "value": {
                      "error": {
                        "code": "AI_UNAVAILABLE",
                        "message": "The AI assistant is unavailable. You can continue with the manual form.",
                        "retryable": true
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "AI_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "AI_TIMEOUT": {
                    "value": {
                      "error": {
                        "code": "AI_TIMEOUT",
                        "message": "The AI assistant is busy. You can continue with the manual form.",
                        "retryable": true
                      },
                      "requestId": "req_trace_123"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
