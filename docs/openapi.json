            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Answer, or the fixed refusal with inScope=false",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteChatResponse"
                },
                "examples": {
                  "inScope": {
                    "value": {
                      "inScope": true,
                      "answer": "Open New request, describe the situation, check the form, drop a pin on the map and press Confirm request."
                    }
                  },
                  "refusal": {
                    "value": {
                      "inScope": false,
                      "answer": "I can only answer questions about how to use the Karwan website."
                    }
                  }
                }
              }
            }
          },
          "400": {
